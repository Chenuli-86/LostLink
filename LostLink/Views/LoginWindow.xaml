<Window x:Class="LostLink.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LostLink - Sign In"
        Width="1180"
        Height="720"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5FBFA">

    <!-- =========================================================
         LOSTLINK LOGIN WINDOW
         Teal / Charcoal / White visual theme
         ========================================================= -->

    <Window.Resources>

        <!-- =====================================================
             COLOUR PALETTE
             ===================================================== -->

        <SolidColorBrush x:Key="PrimaryTeal"
                         Color="#2CB5A7"/>

        <SolidColorBrush x:Key="DarkTeal"
                         Color="#178F86"/>

        <SolidColorBrush x:Key="HeadingColour"
                         Color="#17282D"/>

        <SolidColorBrush x:Key="MutedText"
                         Color="#647C80"/>

        <SolidColorBrush x:Key="LightTeal"
                         Color="#E5F7F4"/>

        <SolidColorBrush x:Key="InputBackground"
                         Color="#FAFDFC"/>


        <!-- =====================================================
             ROUNDED USERNAME TEXTBOX
             ===================================================== -->

        <Style x:Key="RoundedTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="54"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#17282D"/>

            <Setter Property="Background"
                    Value="#FAFDFC"/>

            <Setter Property="BorderBrush"
                    Value="#CDE4E1"/>

            <Setter Property="BorderThickness"
                    Value="1.5"/>

            <Setter Property="Padding"
                    Value="17,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <!-- Highlight the field when the user selects it. -->
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#2CB5A7"/>

                                <Setter TargetName="InputBorder"
                                        Property="Background"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             ROUNDED PASSWORD BOX
             ===================================================== -->

        <Style x:Key="RoundedPasswordBoxStyle"
               TargetType="PasswordBox">

            <Setter Property="Height"
                    Value="54"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#17282D"/>

            <Setter Property="Background"
                    Value="#FAFDFC"/>

            <Setter Property="BorderBrush"
                    Value="#CDE4E1"/>

            <Setter Property="BorderThickness"
                    Value="1.5"/>

            <Setter Property="Padding"
                    Value="17,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="PasswordBox">

                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <!-- Teal border when password field is selected. -->
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="PasswordBorder"
                                        Property="BorderBrush"
                                        Value="#2CB5A7"/>

                                <Setter TargetName="PasswordBorder"
                                        Property="Background"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             SIGN IN BUTTON
             ===================================================== -->

        <Style x:Key="SignInButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="56"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                CornerRadius="15">

                            <Border.Background>

                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">

                                    <GradientStop Color="#42C7B9"
                                                  Offset="0"/>

                                    <GradientStop Color="#1D9F95"
                                                  Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <!-- Button interaction effects. -->
                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.90"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.78"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- =====================================================
             LEFT-SIDE FEATURE CARDS
             ===================================================== -->

        <Style x:Key="FeatureCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#EFFFFFFF"/>

            <Setter Property="BorderBrush"
                    Value="#A8E2DCD8"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="18"/>

            <Setter Property="Padding"
                    Value="16,12"/>

            <Setter Property="Margin"
                    Value="0,0,0,11"/>

        </Style>

    </Window.Resources>


    <!-- =========================================================
         MAIN PAGE
         ========================================================= -->

    <Grid>

        <!-- Soft teal background gradient. -->
        <Grid.Background>

            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">

                <GradientStop Color="#FBFEFD"
                              Offset="0"/>

                <GradientStop Color="#EAF8F6"
                              Offset="0.52"/>

                <GradientStop Color="#D8F1ED"
                              Offset="1"/>

            </LinearGradientBrush>

        </Grid.Background>


        <!-- Decorative background shapes. -->

        <Ellipse Width="520"
                 Height="520"
                 Fill="#20A7DED7"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-250,-250,0,0"/>

        <Ellipse Width="440"
                 Height="440"
                 Fill="#1E70D2C7"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-190,-250"/>

        <Ellipse Width="270"
                 Height="270"
                 Fill="#18B7E5DF"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,-180,0,0"/>


        <!-- Main two-column layout. -->

        <Grid Margin="58,45">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="1.05*"/>

                <ColumnDefinition Width="0.95*"/>

            </Grid.ColumnDefinitions>


            <!-- =================================================
                 LEFT SIDE - LOSTLINK BRANDING
                 ================================================= -->

            <Grid Grid.Column="0"
                  Margin="15,5,55,5">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- LostLink logo and application name. -->

                <StackPanel>

                    <Border Width="62"
                            Height="62"
                            HorizontalAlignment="Left"
                            CornerRadius="17">

                        <Border.Background>

                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">

                                <GradientStop Color="#48CCBE"
                                              Offset="0"/>

                                <GradientStop Color="#1A9A91"
                                              Offset="1"/>

                            </LinearGradientBrush>

                        </Border.Background>

                        <TextBlock Text="L"
                                   Foreground="White"
                                   FontFamily="Georgia"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <StackPanel Orientation="Horizontal"
                                Margin="0,17,0,0">

                        <TextBlock Text="Lost"
                                   Foreground="#17282D"
                                   FontFamily="Georgia"
                                   FontSize="37"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Link"
                                   Foreground="#20A79D"
                                   FontFamily="Georgia"
                                   FontSize="37"
                                   FontWeight="Bold"/>

                    </StackPanel>


                    <TextBlock Text="C A M P U S   L O S T   &amp;   F O U N D"
                               Margin="2,5,0,0"
                               Foreground="#328D86"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                </StackPanel>


                <!-- =================================================
                     APPLICATION INTRODUCTION AND FEATURES
                     ================================================= -->

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">


                    <Border Width="42"
                            Height="3"
                            CornerRadius="2"
                            Background="#2CB5A7"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,24"/>


                    <TextBlock Text="Reconnect people&#x0a;with their belongings."
                               Foreground="#17282D"
                               FontFamily="Georgia"
                               FontSize="34"
                               FontWeight="Bold"
                               LineHeight="43"/>


                    <TextBlock Text="A secure campus management system for reporting, matching and returning lost property."
                               Foreground="#60797D"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               LineHeight="23"
                               TextWrapping="Wrap"
                               MaxWidth="470"
                               HorizontalAlignment="Left"
                               Margin="0,15,0,25"/>


                    <!-- Feature 1: Matching -->

                    <Border Style="{StaticResource FeatureCardStyle}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="52"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="#DDF5F2">

                                <TextBlock Text="⌕"
                                           Foreground="#1A9F95"
                                           FontSize="25"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Smart rule-based item matching"
                                           Foreground="#17282D"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Find the right owner faster"
                                           Foreground="#64817F"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- Feature 2: Role-based access -->

                    <Border Style="{StaticResource FeatureCardStyle}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="52"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="#DDF5F2">

                                <TextBlock Text="◆"
                                           Foreground="#1A9F95"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Secure staff and administrator access"
                                           Foreground="#17282D"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Role-based access to campus records"
                                           Foreground="#64817F"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>


                    <!-- Feature 3: Claims and activity -->

                    <Border Style="{StaticResource FeatureCardStyle}">

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="52"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border Width="40"
                                    Height="40"
                                    CornerRadius="20"
                                    Background="#DDF5F2">

                                <TextBlock Text="▤"
                                           Foreground="#1A9F95"
                                           FontSize="19"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Claims and activity tracking"
                                           Foreground="#17282D"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Manage reports and returns efficiently"
                                           Foreground="#64817F"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </StackPanel>


                <!-- LostLink footer. -->

                <StackPanel Grid.Row="2">

                    <Border Width="38"
                            Height="2"
                            HorizontalAlignment="Left"
                            Background="#2CB5A7"
                            Margin="0,0,0,10"/>

                    <TextBlock Text="LostLink  •  Campus Lost &amp; Found Management"
                               Foreground="#64817F"
                               FontSize="11"/>

                </StackPanel>

            </Grid>


            <!-- =================================================
                 RIGHT SIDE - LOGIN CARD
                 ================================================= -->

            <Border Grid.Column="1"
                    Margin="25,20,15,20"
                    Padding="46,32"
                    CornerRadius="32"
                    Background="#FAFFFFFF">

                <!-- Soft card shadow. -->
                <Border.Effect>

                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="4"
                                      Opacity="0.13"
                                      Color="#326C68"/>

                </Border.Effect>


                <Grid>

                    <!--
                        The form uses the available card height.
                        Reduced internal spacing prevents clipping
                        on smaller supported window sizes.
                    -->

                    <StackPanel HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                MaxWidth="410">


                        <!-- =================================================
                             SECURE PORTAL LABEL
                             ================================================= -->

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,12">

                            <Border Width="9"
                                    Height="9"
                                    CornerRadius="5"
                                    Background="#2CB5A7"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"/>

                            <TextBlock Text="SECURE CAMPUS PORTAL"
                                       Foreground="#218F87"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>


                        <!-- =================================================
                             LOGIN HEADING
                             ================================================= -->

                        <TextBlock Text="Welcome back"
                                   Foreground="#17282D"
                                   FontFamily="Georgia"
                                   FontSize="35"
                                   FontWeight="Bold"
                                   LineHeight="44"/>


                        <TextBlock Text="Sign in with your Staff or Administrator account."
                                   Margin="0,4,0,25"
                                   Foreground="#6E8588"
                                   FontFamily="Segoe UI"
                                   FontSize="15"
                                   LineHeight="21"
                                   TextWrapping="Wrap"/>


                        <!-- =================================================
                             USERNAME
                             ================================================= -->

                        <TextBlock Text="Username"
                                   Foreground="#263A3E"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>


                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource RoundedTextBoxStyle}"/>


                        <!-- =================================================
                             PASSWORD
                             ================================================= -->

                        <TextBlock Text="Password"
                                   Foreground="#263A3E"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,17,0,7"/>


                        <Grid>

                            <!-- Password is hidden by default. -->
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource RoundedPasswordBoxStyle}"/>


                            <!--
                                Used by the existing C# password visibility
                                functionality when the password is revealed.
                            -->
                            <TextBox x:Name="VisiblePasswordTextBox"
                                     Style="{StaticResource RoundedTextBoxStyle}"
                                     Visibility="Collapsed"/>


                            <!-- Show/hide password button. -->
                            <Button x:Name="TogglePasswordButton"
                                    Width="38"
                                    Height="38"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#1A9F95"
                                    FontSize="16"
                                    Cursor="Hand"
                                    Content="◉"
                                    Click="TogglePasswordButton_Click"/>

                        </Grid>


                        <!-- =================================================
                             ERROR MESSAGE
                             Hidden until an authentication error occurs.
                             ================================================= -->

                        <Border x:Name="ErrorBorder"
                                Margin="0,12,0,0"
                                Padding="12"
                                CornerRadius="12"
                                Background="#FFF0F3"
                                Visibility="Collapsed">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="28"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="!"
                                           Foreground="#E23E5D"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>


                                <TextBlock x:Name="ErrorTextBlock"
                                           Grid.Column="1"
                                           Foreground="#D83250"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Border>


                        <!-- =================================================
                             SIGN IN BUTTON
                             ================================================= -->

                        <Button x:Name="LoginButton"
                                Content="Sign In   →"
                                Margin="0,18,0,0"
                                Style="{StaticResource SignInButtonStyle}"
                                Click="LoginButton_Click"/>


                        <!-- =================================================
                             STAFF PORTAL DIVIDER
                             ================================================= -->

                        <Grid Margin="0,20,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <Border Height="1"
                                    Background="#D5E8E5"
                                    VerticalAlignment="Center"/>


                            <TextBlock Grid.Column="1"
                                       Text="STAFF &amp; ADMINISTRATOR ACCESS"
                                       Margin="15,0"
                                       Foreground="#71918E"
                                       FontFamily="Segoe UI"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>


                            <Border Grid.Column="2"
                                    Height="1"
                                    Background="#D5E8E5"
                                    VerticalAlignment="Center"/>

                        </Grid>


                        <!-- =================================================
                             SECURITY INFORMATION
                             Extra line height and padding prevent text
                             descenders such as g, p and y being clipped.
                             ================================================= -->

                        <StackPanel Margin="0,13,0,0">

                            <TextBlock Text="Authorised campus staff and administrators only"
                                       HorizontalAlignment="Center"
                                       Foreground="#4D6A6D"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Padding="0,1,0,2"/>


                            <TextBlock Text="Credentials are securely verified before access is granted."
                                       HorizontalAlignment="Center"
                                       Foreground="#687F82"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       LineHeight="19"
                                       Margin="0,2,0,0"
                                       Padding="0,1,0,4"
                                       TextAlignment="Center"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>